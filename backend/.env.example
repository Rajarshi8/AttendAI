# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=AttendAI Face Recognition API
# Set to "production" on Render
APP_ENV=development
# Set to "false" in production
APP_DEBUG=true
API_PREFIX=/api

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated. Use CORS_ORIGINS_RAW (not CORS_ORIGINS) to avoid pydantic-settings JSON parse
CORS_ORIGINS_RAW=http://localhost:3000

# ── Proxy / real IP ──────────────────────────────────────────────────────────
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=0

# ── Appwrite ──────────────────────────────────────────────────────────────────
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<YOUR_PROJECT_ID>
APPWRITE_API_KEY=<YOUR_SERVER_API_KEY>
APPWRITE_DATABASE_ID=<DATABASE_ID>
APPWRITE_USERS_COLLECTION_ID=<USERS_COLLECTION_ID>
APPWRITE_SESSIONS_COLLECTION_ID=<SESSIONS_COLLECTION_ID>
APPWRITE_ATTENDANCE_COLLECTION_ID=<ATTENDANCE_COLLECTION_ID>

# ── AI / Face recognition ─────────────────────────────────────────────────────
FACE_MODEL=Facenet512
DEFAULT_SIMILARITY_THRESHOLD=0.6
FRAME_PROCESS_STRIDE=3
MAX_FRAME_WIDTH=640
LIVENESS_MIN_FRAMES=6
LIVENESS_MIN_DISPLACEMENT=15

# ── Face detection quality ───────────────────────────────────────────────────
MIN_FACE_BRIGHTNESS=45
LOW_LIGHT_BOOST_THRESHOLD=75
MAX_FACE_CENTER_OFFSET_RATIO=0.35

# ── Embedding cache ───────────────────────────────────────────────────────────
CACHE_REFRESH_INTERVAL_MINUTES=10
CACHE_BACKGROUND_REFRESH_ENABLED=true

# ── Request / image safety ───────────────────────────────────────────────────
MAX_REQUEST_BYTES=8388608
MAX_IMAGE_BYTES=2097152
MAX_IMAGE_WIDTH=1280
MAX_IMAGE_HEIGHT=720
ALLOWED_IMAGE_MIME_TYPES_RAW=image/jpeg,image/png

# ── Geofence ──────────────────────────────────────────────────────────────────
GEOFENCE_BUFFER_METERS=10
GPS_ACCURACY_LIMIT_METERS=50

# ── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_ATTENDANCE=10/minute
RATE_LIMIT_RECOGNIZE=20/minute
